+++ b/flutter_app/lib/hybrid/nasqo_hybrid_flags.dart
@@ -0,0 +1,46 @@
+import 'package:flutter/foundation.dart';
+
+/// Feature flag controller for the experimental NASQO PRO React Hybrid V2
+/// integration branch (`integration/hybrid-seven-20261121` @ `0d734ca`).
+///
+/// Confirmed rollout behavior:
+/// - **Debug APK (`kDebugMode == true`)**: runs the current React UI by default
+///   (`NASQO_REACT_HYBRID_V2` defaults to `kDebugMode`) with local SQLite writes
+///   enabled (`NASQO_REACT_HYBRID_ALLOW_WRITES` defaults to `kDebugMode`), paired
+///   with a one-tap runtime fallback button to return to the previous `0d734ca` UI.
+/// - **Release / Profile builds (`kDebugMode == false`)**: keeps the existing
+///   `0d734ca` Hybrid UI active (`false`) and financial writes gated (`false`)
+///   so production and `main` are never affected unintentionally.
+/// - **Explicit kill-switch in Debug**: pass
+///   `--dart-define=NASQO_REACT_HYBRID_V2=false` or
+///   `--dart-define=NASQO_REACT_HYBRID_ALLOW_WRITES=false` at build time.
+class NasqoHybridFlags {
+  NasqoHybridFlags._();
+
+  static const bool defaultUseReactHybridV2 = bool.fromEnvironment(
+    'NASQO_REACT_HYBRID_V2',
+    defaultValue: kDebugMode,
+  );
+
+  static const bool defaultAllowFinancialWrites = bool.fromEnvironment(
+    'NASQO_REACT_HYBRID_ALLOW_WRITES',
+    defaultValue: kDebugMode,
+  );
+
+  /// `true`  = current React Hybrid V2 offline bundle (default in Debug APK).
+  /// `false` = previous stable `0d734ca` Hybrid / Flutter UI (fallback / Release default).
+  static final ValueNotifier<bool> useReactHybridV2 =
+      ValueNotifier<bool>(defaultUseReactHybridV2);
+
+  /// Independent Dart-side write authorization gate. Never controlled by JS.
+  static final ValueNotifier<bool> allowFinancialWrites =
+      ValueNotifier<bool>(defaultAllowFinancialWrites);
+
+  static void setUseReactHybridV2(bool enabled) {
+    useReactHybridV2.value = enabled;
+  }
+
+  static void setAllowFinancialWrites(bool allowed) {
+    allowFinancialWrites.value = allowed;
+  }
+}

diff --git a/flutter_app/lib/hybrid/hybrid_protocol.dart b/flutter_app/lib/hybrid/hybrid_protocol.dart
new file mode 100644
--- /dev/null
+++ b/flutter_app/lib/hybrid/hybrid_protocol.dart
@@ -0,0 +1,370 @@
+import 'dart:convert';
+import 'package:crypto/crypto.dart';
+
+const String kHybridProtocolVersion = '1.0.0';
+const String kHybridBridgeChannelName = 'NasqoHome';
+
+/// Strict 37-command allowlist matching `src/hybrid/contracts.ts`.
+const Set<String> kHybridAllowedCommands = <String>{
+  'navigate',
+  'goBack',
+  'getSnapshot',
+  'changeCurrency',
+  'saveUiPreferences',
+  'openInvoice',
+  'openVoucher',
+  'openAccountStatement',
+  'printDocument',
+  'exportPdf',
+  'pickFile',
+  'showMessage',
+  'saveWorkspaceSettings',
+  'saveAccountGroup',
+  'saveCurrency',
+  'deleteCurrency',
+  'saveAccount',
+  'deleteAccount',
+  'createLedgerEntry',
+  'updateLedgerEntry',
+  'setLedgerDeleted',
+  'permanentlyDeleteLedger',
+  'saveWarehouse',
+  'createInventoryItem',
+  'updateInventoryItem',
+  'deleteInventoryItem',
+  'importInventoryItems',
+  'batchUpdateInventoryItems',
+  'getInventoryMovementsReport',
+  'getCashboxesReport',
+  'getInvoiceDetail',
+  'getProductPriceStats',
+  'saveErpData',
+  'backupWorkspace',
+  'restoreWorkspace',
+  'resetWorkspace',
+  'googleDriveAction',
+};
+
+/// 17 financial/accounting write commands requiring Dart authorization,
+/// mandatory `idempotencyKey`, and `PostingReceiptGuard` protection.
+const Set<String> kHybridFinancialMutationCommands = <String>{
+  'createLedgerEntry',
+  'updateLedgerEntry',
+  'setLedgerDeleted',
+  'permanentlyDeleteLedger',
+  'saveAccount',
+  'deleteAccount',
+  'saveAccountGroup',
+  'saveCurrency',
+  'deleteCurrency',
+  'saveWarehouse',
+  'createInventoryItem',
+  'updateInventoryItem',
+  'deleteInventoryItem',
+  'importInventoryItems',
+  'batchUpdateInventoryItems',
+  'restoreWorkspace',
+  'resetWorkspace',
+};
+
+const Set<String> kHybridHostEvents = <String>{
+  'snapshotUpdated',
+  'routeChanged',
+  'backPressed',
+  'themeChanged',
+  'currencyChanged',
+  'uiPreferencesUpdated',
+  'serviceError',
+};
+
+const Set<String> kHybridForbiddenPayloadKeys = <String>{
+  'sql',
+  'rawSql',
+  'execSql',
+  'sqliteQuery',
+  'shellCommand',
+  'commandLine',
+  'evalCode',
+  '__proto__',
+  'constructor',
+  'prototype',
+};
+
+bool isReactHybridV1RawMessage(String rawJson) {
+  final trimmed = rawJson.trimLeft();
+  if (!trimmed.startsWith('{')) return false;
+  try {
+    final decoded = jsonDecode(trimmed);
+    return decoded is Map &&
+        decoded['protocolVersion'] == kHybridProtocolVersion &&
+        decoded['kind'] == 'request';
+  } catch (_) {
+    return false;
+  }
+}
+
+String? findForbiddenPayloadKey(Object? value, {int depth = 0}) {
+  if (depth > 8 || value == null) return null;
+  if (value is List) {
+    for (final item in value) {
+      final hit = findForbiddenPayloadKey(item, depth: depth + 1);
+      if (hit != null) return hit;
+    }
+    return null;
+  }
+  if (value is Map) {
+    for (final entry in value.entries) {
+      final key = entry.key.toString();
+      if (kHybridForbiddenPayloadKeys.contains(key)) {
+        return key;
+      }
+      final hit = findForbiddenPayloadKey(entry.value, depth: depth + 1);
+      if (hit != null) return hit;
+    }
+  }
+  return null;
+}
+
+Object? _canonicalizeValue(Object? value) {
+  if (value is Map) {
+    final sortedKeys = value.keys.map((k) => k.toString()).toList()..sort();
+    final map = <String, Object?>{};
+    for (final k in sortedKeys) {
+      map[k] = _canonicalizeValue(value[k]);
+    }
+    return map;
+  }
+  if (value is List) {
+    return value.map(_canonicalizeValue).toList();
+  }
+  return value;
+}
+
+String computeCanonicalRequestHash(String action, Map<String, Object?> payload) {
+  final canonicalJson = jsonEncode(<String, Object?>{
+    'action': action,
+    'payload': _canonicalizeValue(payload),
+  });
+  return sha256.convert(utf8.encode(canonicalJson)).toString();
+}
+
+class HybridBridgeException implements Exception {
+  const HybridBridgeException(
+    this.code,
+    this.message, {
+    this.retryable = false,
+    this.details,
+  });
+
+  final String code;
+  final String message;
+  final bool retryable;
+  final Map<String, Object?>? details;
+
+  Map<String, Object?> toErrorJson() => <String, Object?>{
+        'code': code,
+        'message': message,
+        'retryable': retryable,
+        if (details != null) 'details': details,
+      };
+}
+
+class HybridRequestEnvelope {
+  const HybridRequestEnvelope({
+    required this.protocolVersion,
+    required this.requestId,
+    required this.action,
+    required this.payload,
+    required this.timestampMs,
+    this.idempotencyKey,
+  });
+
+  final String protocolVersion;
+  final String requestId;
+  final String action;
+  final Map<String, Object?> payload;
+  final int timestampMs;
+  final String? idempotencyKey;
+
+  static HybridRequestEnvelope parse(Object? raw) {
+    Object? decoded = raw;
+    if (raw is String) {
+      try {
+        decoded = jsonDecode(raw);
+      } catch (_) {
+        throw const HybridBridgeException(
+          'INVALID_REQUEST',
+          'تعذر تحليل رسالة JSON الواردة عبر الجسر.',
+        );
+      }
+    }
+
+    if (decoded is! Map) {
+      throw const HybridBridgeException(
+        'INVALID_REQUEST',
+        'الرسالة الواردة يجب أن تكون كائن JSON صالحًا.',
+      );
+    }
+
+    final map = decoded.map((k, v) => MapEntry(k.toString(), v));
+
+    if (map['protocolVersion'] != kHybridProtocolVersion) {
+      throw HybridBridgeException(
+        'INVALID_REQUEST',
+        'إصدار البروتوكول غير مدعوم: ${map['protocolVersion']}',
+      );
+    }
+    if (map['kind'] != 'request') {
+      throw const HybridBridgeException(
+        'INVALID_REQUEST',
+        'نوع الرسالة يجب أن يكون request.',
+      );
+    }
+
+    final requestId = map['requestId'];
+    if (requestId is! String ||
+        requestId.trim().length < 4 ||
+        requestId.length > 128) {
+      throw const HybridBridgeException(
+        'INVALID_REQUEST',
+        'معرف الطلب (requestId) غير صالح.',
+      );
+    }
+
+    final action = map['action'];
+    if (action is! String || !kHybridAllowedCommands.contains(action)) {
+      throw HybridBridgeException(
+        'UNAUTHORIZED_ACTION',
+        'الأمر غير مصرح به في جسر Dart: $action',
+      );
+    }
+
+    final rawPayload = map['payload'];
+    if (rawPayload is! Map) {
+      throw const HybridBridgeException(
+        'VALIDATION_ERROR',
+        'بيانات الطلب (payload) يجب أن تكون كائنًا.',
+      );
+    }
+
+    final payload = rawPayload.map((k, v) => MapEntry(k.toString(), v));
+    final forbiddenKey = findForbiddenPayloadKey(payload);
+    if (forbiddenKey != null) {
+      throw HybridBridgeException(
+        'UNAUTHORIZED_ACTION',
+        'تم رفض حقل محظور أمنيًا في الطلب: $forbiddenKey',
+      );
+    }
+
+    final rawIdem = map['idempotencyKey'];
+    final idempotencyKey = rawIdem is String ? rawIdem.trim() : null;
+    if (kHybridFinancialMutationCommands.contains(action)) {
+      if (idempotencyKey == null || idempotencyKey.length < 6) {
+        throw const HybridBridgeException(
+          'VALIDATION_ERROR',
+          'العمليات المالية تتطلب مفتاح عدم التكرار (idempotencyKey) صالحًا.',
+        );
+      }
+    }
+
+    final ts = map['timestampMs'];
+    final timestampMs = ts is num
+        ? ts.toInt()
+        : DateTime.now().millisecondsSinceEpoch;
+
+    return HybridRequestEnvelope(
+      protocolVersion: kHybridProtocolVersion,
+      requestId: requestId.trim(),
+      action: action,
+      payload: payload,
+      timestampMs: timestampMs,
+      idempotencyKey: idempotencyKey,
+    );
+  }
+}
+
+class HybridResponseEnvelope {
+  const HybridResponseEnvelope({
+    required this.requestId,
+    required this.ok,
+    this.action,
+    this.data,
+    this.error,
+    required this.timestampMs,
+  });
+
+  final String requestId;
+  final String? action;
+  final bool ok;
+  final Object? data;
+  final Map<String, Object?>? error;
+  final int timestampMs;
+
+  factory HybridResponseEnvelope.success({
+    required String requestId,
+    required String action,
+    Object? data,
+  }) =>
+      HybridResponseEnvelope(
+        requestId: requestId,
+        action: action,
+        ok: true,
+        data: data,
+        timestampMs: DateTime.now().millisecondsSinceEpoch,
+      );
+
+  factory HybridResponseEnvelope.failure({
+    required String requestId,
+    String? action,
+    required HybridBridgeException error,
+  }) =>
+      HybridResponseEnvelope(
+        requestId: requestId,
+        action: action,
+        ok: false,
+        error: error.toErrorJson(),
+        timestampMs: DateTime.now().millisecondsSinceEpoch,
+      );
+
+  Map<String, Object?> toJson() => <String, Object?>{
+        'protocolVersion': kHybridProtocolVersion,
+        'kind': 'response',
+        'requestId': requestId,
+        if (action != null) 'action': action,
+        'ok': ok,
+        if (ok) 'data': data,
+        if (!ok && error != null) 'error': error,
+        'timestampMs': timestampMs,
+      };
+
+  String toJsonString() => jsonEncode(toJson());
+}
+
+class HybridHostEventEnvelope {
+  const HybridHostEventEnvelope({
+    required this.event,
+    required this.payload,
+    required this.timestampMs,
+  });
+
+  final String event;
+  final Object? payload;
+  final int timestampMs;
+
+  factory HybridHostEventEnvelope.create(String event, Object? payload) {
+    assert(kHybridHostEvents.contains(event));
+    return HybridHostEventEnvelope(
+      event: event,
+      payload: payload,
+      timestampMs: DateTime.now().millisecondsSinceEpoch,
+    );
+  }
+
+  String toJsonString() => jsonEncode(<String, Object?>{
+        'protocolVersion': kHybridProtocolVersion,
+        'kind': 'event',
+        'event': event,
+        'payload': payload,
+        'timestampMs': timestampMs,
+      });
+}

diff --git a/flutter_app/lib/hybrid/posting_receipt_guard.dart b/flutter_app/lib/hybrid/posting_receipt_guard.dart
new file mode 100644
--- /dev/null
+++ b/flutter_app/lib/hybrid/posting_receipt_guard.dart
@@ -0,0 +1,216 @@
+import 'dart:convert';
+import 'package:sqflite/sqflite.dart';
+import 'hybrid_protocol.dart';
+
+/// Structured receipt mirroring NASQO Flutter's `PostingReceipt` protection model.
+///
+/// When integrating on branch `integration/hybrid-seven-20261121` (commit 0d734ca),
+/// map this directly to/from the existing `PostingReceipt` class in your financial
+/// posting service via [ExternalPostingReceiptBridge] so there is a single
+/// receipt source across Flutter and React Hybrid.
+class HybridPostingReceipt {
+  const HybridPostingReceipt({
+    required this.receiptId,
+    required this.idempotencyKey,
+    required this.action,
+    required this.requestHash,
+    required this.postedAtMs,
+    this.ledgerEntryId,
+    this.entryNumber,
+    this.replayed = false,
+  });
+
+  final String receiptId;
+  final String idempotencyKey;
+  final String action;
+  final String requestHash;
+  final int postedAtMs;
+  final String? ledgerEntryId;
+  final int? entryNumber;
+  final bool replayed;
+
+  Map<String, Object?> toJson() => <String, Object?>{
+        'receiptId': receiptId,
+        'idempotencyKey': idempotencyKey,
+        'action': action,
+        'requestHash': requestHash,
+        'postedAtMs': postedAtMs,
+        if (ledgerEntryId != null) 'ledgerEntryId': ledgerEntryId,
+        if (entryNumber != null) 'entryNumber': entryNumber,
+        'replayed': replayed,
+      };
+}
+
+/// Optional delegate to plug in the existing `PostingReceipt` store/service
+/// from commit 0d734ca if it already persists receipts inside `LocalDatabase`.
+abstract class ExternalPostingReceiptBridge {
+  Future<HybridPostingReceipt?> findByIdempotencyKey(String idempotencyKey);
+  Future<void> recordReceipt(
+    HybridPostingReceipt receipt,
+    String responseJson,
+  );
+}
+
+/// Guard that prevents duplicate financial posting using the EXISTING
+/// `LocalDatabase` SQLite connection (`nasqo_pro_erp.db` — NEVER a parallel DB).
+///
+/// Adds one lightweight guard table (`posting_receipts`) inside the SAME
+/// SQLite database with `idempotency_key TEXT PRIMARY KEY` and executes the
+/// check + write atomically inside `db.transaction`.
+class PostingReceiptGuard {
+  PostingReceiptGuard({
+    required Future<Database> Function() databaseProvider,
+    this.externalBridge,
+  }) : _databaseProvider = databaseProvider;
+
+  final Future<Database> Function() _databaseProvider;
+  final ExternalPostingReceiptBridge? externalBridge;
+  bool _tableEnsured = false;
+
+  static const String tableName = 'posting_receipts';
+
+  static Future<void> ensureTable(DatabaseExecutor db) async {
+    await db.execute('''
+      CREATE TABLE IF NOT EXISTS $tableName (
+        idempotency_key TEXT PRIMARY KEY,
+        receipt_id TEXT NOT NULL,
+        action TEXT NOT NULL,
+        request_hash TEXT NOT NULL,
+        ledger_entry_id TEXT,
+        entry_number INTEGER,
+        response_json TEXT NOT NULL,
+        created_at_ms INTEGER NOT NULL
+      )
+    ''');
+  }
+
+  /// Executes [postWork] exactly once for a given [idempotencyKey].
+  ///
+  /// - First call: executes [postWork], persists both the domain changes and
+  ///   the `PostingReceipt` record, and returns `{...result, 'postingReceipt': ...}`.
+  /// - Identical retry (same key + action + canonical payload hash): returns
+  ///   the cached response with `postingReceipt.replayed == true` without re-posting.
+  /// - Conflicting reuse (same key + different action or altered payload):
+  ///   throws `HybridBridgeException('DUPLICATE_REQUEST', ...)`.
+  Future<Map<String, Object?>> executeProtected({
+    required String action,
+    required String idempotencyKey,
+    required Map<String, Object?> payload,
+    required Future<Map<String, Object?>> Function(
+      Transaction txn,
+      String receiptId,
+    ) postWork,
+  }) async {
+    final db = await _databaseProvider();
+    if (!_tableEnsured) {
+      await ensureTable(db);
+      _tableEnsured = true;
+    }
+
+    final requestHash = computeCanonicalRequestHash(action, payload);
+    final nowMs = DateTime.now().millisecondsSinceEpoch;
+
+    if (externalBridge != null) {
+      final externalExisting =
+          await externalBridge!.findByIdempotencyKey(idempotencyKey);
+      if (externalExisting != null &&
+          (externalExisting.action != action ||
+              externalExisting.requestHash != requestHash)) {
+        throw const HybridBridgeException(
+          'DUPLICATE_REQUEST',
+          'تم رفض العملية: مفتاح PostingReceipt مستخدم مسبقًا لعملية مختلفة.',
+        );
+      }
+    }
+
+    return db.transaction<Map<String, Object?>>((txn) async {
+      await ensureTable(txn);
+
+      final existing = await txn.query(
+        tableName,
+        where: 'idempotency_key = ?',
+        whereArgs: [idempotencyKey],
+        limit: 1,
+      );
+
+      if (existing.isNotEmpty) {
+        final row = existing.first;
+        final prevAction = row['action'] as String? ?? '';
+        final prevHash = row['request_hash'] as String? ?? '';
+
+        if (prevAction == action && prevHash == requestHash) {
+          final decoded = jsonDecode(row['response_json'] as String);
+          final resultMap = decoded is Map
+              ? decoded.map((k, v) => MapEntry(k.toString(), v))
+              : <String, Object?>{};
+          final receipt = HybridPostingReceipt(
+            receiptId: row['receipt_id'] as String? ?? '',
+            idempotencyKey: idempotencyKey,
+            action: prevAction,
+            requestHash: prevHash,
+            postedAtMs: (row['created_at_ms'] as num?)?.toInt() ?? nowMs,
+            ledgerEntryId: row['ledger_entry_id'] as String?,
+            entryNumber: (row['entry_number'] as num?)?.toInt(),
+            replayed: true,
+          );
+          resultMap['postingReceipt'] = receipt.toJson();
+          return resultMap;
+        }
+
+        throw const HybridBridgeException(
+          'DUPLICATE_REQUEST',
+          'تم رفض الطلب: مفتاح عدم التكرار (PostingReceipt) مستخدم مسبقًا ببيانات مختلفة.',
+        );
+      }
+
+      final receiptId = 'rcpt_${nowMs}_${idempotencyKey.hashCode.abs()}';
+      final result = await postWork(txn, receiptId);
+
+      String? ledgerEntryId;
+      int? entryNumber;
+      final entryObj = result['entry'];
+      if (entryObj is Map) {
+        ledgerEntryId = entryObj['id'] as String?;
+        entryNumber = (entryObj['entryNumber'] as num?)?.toInt();
+      }
+
+      final receipt = HybridPostingReceipt(
+        receiptId: receiptId,
+        idempotencyKey: idempotencyKey,
+        action: action,
+        requestHash: requestHash,
+        postedAtMs: nowMs,
+        ledgerEntryId: ledgerEntryId,
+        entryNumber: entryNumber,
+        replayed: false,
+      );
+
+      final enriched = <String, Object?>{
+        ...result,
+        'postingReceipt': receipt.toJson(),
+      };
+      final encodedResponse = jsonEncode(enriched);
+
+      await txn.insert(
+        tableName,
+        <String, Object?>{
+          'idempotency_key': idempotencyKey,
+          'receipt_id': receiptId,
+          'action': action,
+          'request_hash': requestHash,
+          'ledger_entry_id': ledgerEntryId,
+          'entry_number': entryNumber,
+          'response_json': encodedResponse,
+          'created_at_ms': nowMs,
+        },
+        conflictAlgorithm: ConflictAlgorithm.abort,
+      );
+
+      if (externalBridge != null) {
+        await externalBridge!.recordReceipt(receipt, encodedResponse);
+      }
+
+      return enriched;
+    });
+  }
+}

