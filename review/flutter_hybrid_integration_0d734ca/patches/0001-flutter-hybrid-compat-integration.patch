+    required EntryDirection direction,
+    required String typeLabel,
+  }) {
+    if (kind == LedgerKind.invoice) {
+      if (typeLabel.contains('مشتريات') || direction == EntryDirection.credit) {
+        return 1;
+      }
+      return -1;
+    }
+    if (kind == LedgerKind.returnEntry) {
+      if (typeLabel.contains('مشتريات')) return -1;
+      return 1;
+    }
+    return 0;
+  }
+
+  static CurrencyCode _parseCurrencyCode(String? raw) {
+    final clean = (raw ?? '').trim();
+    for (final code in CurrencyCode.values) {
+      if (code.label == clean || code.name == clean.toLowerCase()) return code;
+    }
+    return CurrencyCode.sar;
+  }
+
+  static AccountCategory _parseCategory(String? raw) {
+    final clean = (raw ?? '').trim();
+    for (final c in AccountCategory.values) {
+      if (c.name == clean || c.label == clean) return c;
+    }
+    return AccountCategory.purchases;
+  }
+
+  static LedgerKind _parseLedgerKind(String? raw) {
+    return switch (raw) {
+      'invoice' => LedgerKind.invoice,
+      'return' => LedgerKind.returnEntry,
+      'quote' => LedgerKind.quote,
+      'order' => LedgerKind.order,
+      'transfer' => LedgerKind.transfer,
+      'currency' => LedgerKind.currency,
+      'simple-entry' => LedgerKind.simpleEntry,
+      'opening' => LedgerKind.opening,
+      _ => LedgerKind.voucher,
+    };
+  }
+
+  static String _ledgerKindToHybrid(LedgerKind kind) {
+    return switch (kind) {
+      LedgerKind.returnEntry => 'return',
+      LedgerKind.simpleEntry => 'simple-entry',
+      _ => kind.name,
+    };
+  }
+
+  static PaymentMethod _parsePayment(String? raw) {
+    for (final p in PaymentMethod.values) {
+      if (p.name == raw || p.label == raw) return p;
+    }
+    return PaymentMethod.credit;
+  }
+
+  static Map<String, Object?>? _nestedMap(Object? raw) {
+    if (raw is! Map) return null;
+    return raw.map((k, v) => MapEntry(k.toString(), v));
+  }
+
+  static double _toDouble(Object? raw, {required double fallback}) {
+    if (raw is num) return raw.toDouble();
+    if (raw is String) return double.tryParse(raw.trim()) ?? fallback;
+    return fallback;
+  }
+
+  static AccountRecord _accountFromDbRow(Map<String, Object?> row) =>
+      AccountRecord(
+        id: (row['id'] as String?) ?? _genId('acc'),
+        name: (row['name'] as String?) ?? 'حساب',
+        category: _parseCategory(row['category'] as String?),
+        phone: (row['phone'] as String?) ?? '',
+        creditLimit: _toDouble(row['creditLimit'], fallback: 50000),
+        currency: _parseCurrencyCode(row['currency'] as String?),
+        isCashAccount: (row['isCashAccount'] as num?) == 1,
+        note: (row['note'] as String?) ?? '',
+        openingBalance: _toDouble(row['openingBalance'], fallback: 0),
+        openingDirection: row['openingDirection'] == 'debit'
+            ? EntryDirection.debit
+            : EntryDirection.credit,
+        codeNumber: (row['codeNumber'] as num?)?.toInt() ?? 1,
+      );
+
+  static LedgerEntryRecord _ledgerFromDbRow(Map<String, Object?> row) =>
+      LedgerEntryRecord(
+        id: (row['id'] as String?) ?? _genId('led'),
+        accountId: (row['accountId'] as String?) ?? '',
+        accountName: (row['accountName'] as String?) ?? '',
+        kind: _parseLedgerKind(row['kind'] as String?),
+        typeLabel: (row['typeLabel'] as String?) ?? 'قيد مالي',
+        payment: _parsePayment(row['payment'] as String?),
+        direction: row['direction'] == 'credit'
+            ? EntryDirection.credit
+            : EntryDirection.debit,
+        amount: _toDouble(row['amount'], fallback: 0),
+        currency: _parseCurrencyCode(row['currency'] as String?),
+        exchangeRate: _toDouble(row['exchangeRate'], fallback: 1.0),
+        details: (row['details'] as String?) ?? '',
+        documentNumber: (row['documentNumber'] as String?) ?? '',
+        warehouseId: (row['warehouseId'] as String?) ?? 'wh_main',
+        warehouseName: (row['warehouseName'] as String?) ?? 'المخزن الرئيسي',
+        expenseCategory: (row['expenseCategory'] as String?) ?? '',
+        entryNumber: (row['entryNumber'] as num?)?.toInt() ?? 1001,
+        deleted: (row['deleted'] as num?) == 1,
+        entryDate: (row['entryDate'] as String?) ??
+            DateTime.now().toIso8601String().substring(0, 10),
+      );
+
+  static WarehouseRecord _warehouseFromDbRow(Map<String, Object?> row) =>
+      WarehouseRecord(
+        id: (row['id'] as String?) ?? _genId('wh'),
+        name: (row['name'] as String?) ?? 'المخزن الرئيسي',
+        details: (row['details'] as String?) ?? '',
+        isDefault: (row['isDefault'] as num?) == 1,
+      );
+
+  static InventoryItemRecord _inventoryFromDbRow(Map<String, Object?> row) =>
+      InventoryItemRecord(
+        id: (row['id'] as String?) ?? _genId('inv'),
+        name: (row['name'] as String?) ?? 'صنف',
+        unit: (row['unit'] as String?) ?? 'حبة',
+        quantity: _toDouble(row['quantity'], fallback: 0),
+        avgCost: _toDouble(row['avgCost'], fallback: 0),
+        warehouseId: (row['warehouseId'] as String?) ?? 'wh_main',
+        minThreshold: _toDouble(row['minThreshold'], fallback: 25),
+        sku: (row['sku'] as String?) ?? '',
+      );
+
+  static int _seq = 0;
+  static String _genId(String prefix) {
+    _seq += 1;
+    return '${prefix}_${DateTime.now().millisecondsSinceEpoch}_$_seq';
+  }
+}

diff --git a/flutter_app/lib/hybrid/hybrid_bridge_router.dart b/flutter_app/lib/hybrid/hybrid_bridge_router.dart
new file mode 100644
--- /dev/null
+++ b/flutter_app/lib/hybrid/hybrid_bridge_router.dart
@@ -0,0 +1,400 @@
+import 'dart:convert';
+import 'erp_hybrid_adapter.dart';
+import 'hybrid_protocol.dart';
+
+typedef HybridNativeActionCallback = Future<Map<String, Object?>?> Function(
+  String action,
+  Map<String, Object?> payload,
+);
+
+/// Callback invoked for legacy `0d734ca` `NasqoHome` messages that do NOT carry
+/// `protocolVersion: "1.0.0"`. Guarantees zero regressions in the existing bridge.
+typedef LegacyNasqoHomeHandler = Future<String?> Function(String rawMessage);
+
+/// Compatibility router for the existing `NasqoHome` WebViewCompat channel.
+///
+/// - Legacy messages (from commit 0d734ca) pass untouched to [legacyHandler].
+/// - v1.0.0 React Hybrid envelopes pass through independent Dart validation,
+///   allowlist checks, [allowFinancialWrites] gating, and [ErpHybridAdapter]
+///   (backed by `ErpController` + `LocalDatabase` + `PostingReceiptGuard`).
+class HybridBridgeRouter {
+  HybridBridgeRouter({
+    required this.adapter,
+    required this.allowFinancialWrites,
+    this.legacyHandler,
+    this.onNavigate,
+    this.onGoBack,
+    this.onShowMessage,
+    this.onThemeModeChanged,
+    this.onNativeServiceAction,
+    this.onSnapshotUpdated,
+  });
+
+  final ErpHybridAdapter adapter;
+  final bool Function() allowFinancialWrites;
+  final LegacyNasqoHomeHandler? legacyHandler;
+  final void Function(String route, Map<String, Object?> params)? onNavigate;
+  final void Function(String? currentRoute, int? stackDepth)? onGoBack;
+  final void Function(String message, String level)? onShowMessage;
+  final void Function(String themeMode)? onThemeModeChanged;
+  final HybridNativeActionCallback? onNativeServiceAction;
+  final void Function(Map<String, Object?> snapshot)? onSnapshotUpdated;
+
+  /// Routes an inbound message from `NasqoHome`.
+  /// Returns a JSON response string, or `null` if [legacyHandler] handled it silently.
+  Future<String?> handleRawMessage(String rawJson) async {
+    if (!isReactHybridV1RawMessage(rawJson) && legacyHandler != null) {
+      return legacyHandler!(rawJson);
+    }
+
+    String fallbackRequestId = 'unknown';
+    String? fallbackAction;
+
+    try {
+      final dynamic preview = jsonDecode(rawJson);
+      if (preview is Map) {
+        if (preview['requestId'] is String) {
+          fallbackRequestId = preview['requestId'] as String;
+        }
+        if (preview['action'] is String) {
+          fallbackAction = preview['action'] as String;
+        }
+      }
+    } catch (_) {}
+
+    try {
+      final request = HybridRequestEnvelope.parse(rawJson);
+      final data = await dispatch(request);
+      return HybridResponseEnvelope.success(
+        requestId: request.requestId,
+        action: request.action,
+        data: data,
+      ).toJsonString();
+    } on HybridBridgeException catch (e) {
+      return HybridResponseEnvelope.failure(
+        requestId: fallbackRequestId,
+        action: fallbackAction,
+        error: e,
+      ).toJsonString();
+    } catch (e) {
+      return HybridResponseEnvelope.failure(
+        requestId: fallbackRequestId,
+        action: fallbackAction,
+        error: HybridBridgeException(
+          'INTERNAL_ERROR',
+          'تعذر تنفيذ الأمر عبر جسر Flutter: $e',
+        ),
+      ).toJsonString();
+    }
+  }
+
+  Future<Object?> dispatch(HybridRequestEnvelope request) async {
+    final writesAllowed = allowFinancialWrites();
+
+    if (kHybridFinancialMutationCommands.contains(request.action) &&
+        !writesAllowed) {
+      throw const HybridBridgeException(
+        'UNAUTHORIZED_ACTION',
+        'الترحيل المالي مغلق حاليًا في Flutter (NASQO_REACT_HYBRID_ALLOW_WRITES=false).',
+      );
+    }
+
+    final payload = request.payload;
+
+    switch (request.action) {
+      case 'getSnapshot':
+        return adapter.getSnapshot(allowFinancialWrites: writesAllowed);
+
+      case 'navigate':
+        final route = (payload['route'] as String? ?? '/').trim();
+        final rawParams = payload['params'];
+        final params = rawParams is Map
+            ? rawParams.map((k, v) => MapEntry(k.toString(), v))
+            : <String, Object?>{};
+        onNavigate?.call(route, params);
+        return <String, Object?>{'navigated': true, 'route': route};
+
+      case 'goBack':
+        onGoBack?.call(
+          payload['currentRoute'] as String?,
+          (payload['stackDepth'] as num?)?.toInt(),
+        );
+        return <String, Object?>{'handled': true};
+
+      case 'changeCurrency':
+        return adapter.changeCurrency((payload['currency'] as String? ?? '').trim());
+
+      case 'saveUiPreferences':
+        final rawPrefs = payload['preferences'];
+        if (rawPrefs is! Map) {
+          throw const HybridBridgeException(
+            'VALIDATION_ERROR',
+            'تفضيلات الواجهة يجب أن تكون كائنًا.',
+          );
+        }
+        final prefs = rawPrefs.map((k, v) => MapEntry(k.toString(), v));
+        final themeMode = prefs['themeMode'];
+        if (themeMode is String && themeMode.isNotEmpty) {
+          onThemeModeChanged?.call(themeMode);
+        }
+        return adapter.saveUiPreferences(prefs);
+
+      case 'openInvoice':
+      case 'openVoucher':
+      case 'openAccountStatement':
+        return <String, Object?>{'opened': true, 'action': request.action};
+
+      case 'showMessage':
+        final msg = (payload['message'] as String? ?? '').trim();
+        final level = (payload['level'] as String? ?? 'info').trim();
+        if (msg.isNotEmpty) onShowMessage?.call(msg, level);
+        return <String, Object?>{'shown': true};
+
+      case 'printDocument':
+      case 'exportPdf':
+      case 'pickFile':
+      case 'googleDriveAction':
+        if (onNativeServiceAction != null) {
+          final custom = await onNativeServiceAction!(request.action, payload);
+          if (custom != null) return custom;
+        }
+        if (request.action == 'pickFile') {
+          return const <String, Object?>{
+            'cancelled': true,
+            'fileName': '',
+            'mimeType': 'application/octet-stream',
+            'sizeBytes': 0,
+            'base64Content': '',
+          };
+        }
+        if (request.action == 'googleDriveAction') {
+          return const <String, Object?>{
+            'connected': false,
+            'offlineOnly': true,
+          };
+        }
+        return <String, Object?>{'queued': true, 'action': request.action};
+
+      case 'saveWorkspaceSettings':
+        final rawUpdates = payload['updates'];
+        final updates = rawUpdates is Map
+            ? rawUpdates.map((k, v) => MapEntry(k.toString(), v))
+            : payload;
+        return _emitIfSnapshot(
+          await adapter.saveWorkspaceSettings(
+            updates,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'saveAccountGroup':
+        return _emitIfSnapshot(
+          await adapter.saveAccountGroup(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'saveCurrency':
+        return _emitIfSnapshot(
+          await adapter.saveCurrency(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'deleteCurrency':
+        return _emitIfSnapshot(
+          await adapter.deleteCurrency(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'saveAccount':
+        return _emitIfSnapshot(
+          await adapter.saveAccount(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'deleteAccount':
+        return _emitIfSnapshot(
+          await adapter.deleteAccount(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'createLedgerEntry':
+        return _emitIfSnapshot(
+          await adapter.createLedgerEntry(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'updateLedgerEntry':
+        return _emitIfSnapshot(
+          await adapter.updateLedgerEntry(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'setLedgerDeleted':
+        return _emitIfSnapshot(
+          await adapter.setLedgerDeleted(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'permanentlyDeleteLedger':
+        return _emitIfSnapshot(
+          await adapter.permanentlyDeleteLedger(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'saveWarehouse':
+        return _emitIfSnapshot(
+          await adapter.saveWarehouse(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'createInventoryItem':
+        return _emitIfSnapshot(
+          await adapter.createInventoryItem(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'updateInventoryItem':
+        return _emitIfSnapshot(
+          await adapter.updateInventoryItem(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'deleteInventoryItem':
+        return _emitIfSnapshot(
+          await adapter.deleteInventoryItem(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'importInventoryItems':
+        return _emitIfSnapshot(
+          await adapter.importInventoryItems(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'batchUpdateInventoryItems':
+        return _emitIfSnapshot(
+          await adapter.batchUpdateInventoryItems(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'getInventoryMovementsReport':
+        final rawOpts = payload['options'];
+        final opts = rawOpts is Map
+            ? rawOpts.map((k, v) => MapEntry(k.toString(), v))
+            : <String, Object?>{};
+        return adapter.getInventoryMovementsReport(opts);
+
+      case 'getCashboxesReport':
+        final rawOpts = payload['options'];
+        final opts = rawOpts is Map
+            ? rawOpts.map((k, v) => MapEntry(k.toString(), v))
+            : <String, Object?>{};
+        return adapter.getCashboxesReport(opts);
+
+      case 'getInvoiceDetail':
+        return adapter.getInvoiceDetail(
+          (payload['entryId'] as String? ?? '').trim(),
+        );
+
+      case 'getProductPriceStats':
+        return adapter.getProductPriceStats(
+          (payload['itemId'] as String? ?? '').trim(),
+        );
+
+      case 'saveErpData':
+        final rawData = payload['data'];
+        if (rawData is! Map) {
+          throw const HybridBridgeException(
+            'VALIDATION_ERROR',
+            'بيانات ERP غير صالحة.',
+          );
+        }
+        return adapter.saveErpData(
+          rawData.map((k, v) => MapEntry(k.toString(), v)),
+        );
+
+      case 'backupWorkspace':
+        return adapter.backupWorkspace(
+          backupName: (payload['backupName'] as String? ?? '').trim(),
+          allowFinancialWrites: writesAllowed,
+        );
+
+      case 'restoreWorkspace':
+        return _emitIfSnapshot(
+          await adapter.restoreWorkspace(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      case 'resetWorkspace':
+        return _emitIfSnapshot(
+          await adapter.resetWorkspace(
+            idempotencyKey: request.idempotencyKey!,
+            payload: payload,
+            allowFinancialWrites: writesAllowed,
+          ),
+        );
+
+      default:
+        throw HybridBridgeException(
+          'UNAUTHORIZED_ACTION',
+          'الأمر غير مدعوم: ${request.action}',
+        );
+    }
+  }
+
+  Map<String, Object?> _emitIfSnapshot(Map<String, Object?> result) {
+    final snap = result['snapshot'];
+    if (snap is Map<String, Object?>) {
+      onSnapshotUpdated?.call(snap);
+    }
+    return result;
+  }
+}

diff --git a/flutter_app/lib/hybrid/hybrid_react_v2_shell.dart b/flutter_app/lib/hybrid/hybrid_react_v2_shell.dart
new file mode 100644
--- /dev/null
+++ b/flutter_app/lib/hybrid/hybrid_react_v2_shell.dart
@@ -0,0 +1,253 @@
+import 'dart:async';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import '../services/local_database.dart';
+import '../state/erp_controller.dart';
+import 'erp_hybrid_adapter.dart';
+import 'hybrid_bridge_router.dart';
+import 'hybrid_protocol.dart';
+import 'nasqo_hybrid_flags.dart';
+import 'posting_receipt_guard.dart';
+
+/// Non-destructive Feature Flag shell wrapper preserving `0d734ca` compatibility.
+///
+/// - In experimental **Debug APK** (`kDebugMode == true`), defaults to mounting
+///   the current offline React Hybrid V2 UI inside the existing single Android
+///   WebView (`HybridHomeView.kt` + `NasqoHome`), WITH a one-tap fallback button
+///   (`العودة للنسخة السابقة`) that switches instantly back to [existingHybridChild].
+/// - When `NasqoHybridFlags.useReactHybridV2` is `false` (after tapping fallback,
+///   in Release mode, or with `--dart-define=NASQO_REACT_HYBRID_V2=false`), renders
+///   [existingHybridChild] untouched.
+class HybridReactV2FeatureGate extends StatelessWidget {
+  const HybridReactV2FeatureGate({
+    super.key,
+    required this.controller,
+    required this.existingHybridChild,
+    this.platformViewType = 'nasqo/home',
+    this.legacyMessageHandler,
+    this.showDebugFallbackButton = kDebugMode,
+  });
+
+  final ErpController controller;
+  final Widget existingHybridChild;
+
+  /// Must match the existing PlatformView viewType registered in `MainActivity.kt`
+  /// at commit 0d734ca2ce1716de8f7005f8339f395fbd396da6.
+  final String platformViewType;
+  final LegacyNasqoHomeHandler? legacyMessageHandler;
+  final bool showDebugFallbackButton;
+
+  @override
+  Widget build(BuildContext context) {
+    return ValueListenableBuilder<bool>(
+      valueListenable: NasqoHybridFlags.useReactHybridV2,
+      builder: (context, useV2, _) {
+        if (!useV2) {
+          if (!showDebugFallbackButton) {
+            return existingHybridChild;
+          }
+          return Stack(
+            children: [
+              existingHybridChild,
+              Positioned(
+                left: 12,
+                bottom: 16,
+                child: SafeArea(
+                  child: Material(
+                    color: Colors.transparent,
+                    child: ActionChip(
+                      key: const Key('nasqo_open_react_v2_chip'),
+                      avatar: const Icon(Icons.auto_awesome, size: 16),
+                      label: const Text('واجهة React الحالية'),
+                      onPressed: () =>
+                          NasqoHybridFlags.setUseReactHybridV2(true),
+                    ),
+                  ),
+                ),
+              ),
+            ],
+          );
+        }
+        return _HybridReactV2Host(
+          controller: controller,
+          platformViewType: platformViewType,
+          legacyMessageHandler: legacyMessageHandler,
+          showFallbackButton: showDebugFallbackButton,
+          onReturnToStableHybrid: () =>
+              NasqoHybridFlags.setUseReactHybridV2(false),
+        );
+      },
+    );
+  }
+}
+
+class _HybridReactV2Host extends StatefulWidget {
+  const _HybridReactV2Host({
+    required this.controller,
+    required this.platformViewType,
+    required this.onReturnToStableHybrid,
+    required this.showFallbackButton,
+    this.legacyMessageHandler,
+  });
+
+  final ErpController controller;
+  final String platformViewType;
+  final VoidCallback onReturnToStableHybrid;
+  final bool showFallbackButton;
+  final LegacyNasqoHomeHandler? legacyMessageHandler;
+
+  @override
+  State<_HybridReactV2Host> createState() => _HybridReactV2HostState();
+}
+
+class _HybridReactV2HostState extends State<_HybridReactV2Host> {
+  late final HybridBridgeRouter _router;
+  late final ErpHybridAdapter _adapter;
+  MethodChannel? _channel;
+  bool _ready = false;
+
+  @override
+  void initState() {
+    super.initState();
+    final guard = PostingReceiptGuard(
+      databaseProvider: () => LocalDatabase.instance.database,
+    );
+    _adapter = ErpHybridAdapter(
+      controller: widget.controller,
+      receiptGuard: guard,
+    );
+    // Upgrade-safe initialization: preserves existing LocalDatabase records on
+    // APK upgrade and starts clean & empty on brand-new installs.
+    unawaited(_adapter.loadOrInitializeUpgradeSafe());
+    _router = HybridBridgeRouter(
+      adapter: _adapter,
+      allowFinancialWrites: () => NasqoHybridFlags.allowFinancialWrites.value,
+      legacyHandler: widget.legacyMessageHandler,
+      onGoBack: (_, depth) {
+        if ((depth ?? 0) <= 1) {
+          widget.onReturnToStableHybrid();
+        }
+      },
+      onShowMessage: (message, level) {
+        if (!mounted) return;
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text(message)),
+        );
+      },
+    );
+  }
+
+  @override
+  void dispose() {
+    _channel?.setMethodCallHandler(null);
+    super.dispose();
+  }
+
+  void _onPlatformViewCreated(int viewId) {
+    final ch = MethodChannel('nasqo/home/$viewId');
+    _channel = ch;
+    ch.setMethodCallHandler((call) async {
+      if (call.method == 'onWebMessage' || call.method == 'message') {
+        final raw = call.arguments as String?;
+        if (raw == null || raw.isEmpty) return false;
+        final response = await _router.handleRawMessage(raw);
+        if (response != null) {
+          await ch.invokeMethod<void>('postMessage', response);
+        }
+        return true;
+      }
+      if (call.method == 'onPageFinished') {
+        if (mounted) setState(() => _ready = true);
+        final evt = HybridHostEventEnvelope.create(
+          'themeChanged',
+          <String, Object?>{
+            'mode': widget.controller.isDarkMode ? 'dark' : 'light',
+          },
+        );
+        await ch.invokeMethod<void>('postMessage', evt.toJsonString());
+        return true;
+      }
+      return null;
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final isAndroid = !kIsWeb && defaultTargetPlatform == TargetPlatform.android;
+
+    return PopScope(
+      canPop: false,
+      onPopInvokedWithResult: (didPop, _) {
+        if (didPop) return;
+        if (_ready && _channel != null) {
+          final evt = HybridHostEventEnvelope.create(
+            'backPressed',
+            const <String, Object?>{'source': 'android_system_back'},
+          );
+          unawaited(
+            _channel!.invokeMethod<void>('postMessage', evt.toJsonString()),
+          );
+        } else {
+          widget.onReturnToStableHybrid();
+        }
+      },
+      child: Scaffold(
+        body: SafeArea(
+          child: Stack(
+            children: [
+              if (isAndroid)
+                AndroidView(
+                  viewType: widget.platformViewType,
+                  layoutDirection: TextDirection.rtl,
+                  creationParams: const <String, Object?>{
+                    'useReactHybridV2': true,
+                  },
+                  creationParamsCodec: const StandardMessageCodec(),
+                  onPlatformViewCreated: _onPlatformViewCreated,
+                )
+              else
+                Center(
+                  child: Column(
+                    mainAxisSize: MainAxisSize.min,
+                    children: [
+                      const Text(
+                        'React Hybrid V2 يتطلب Android WebViewCompat (com.indexesstore.nasqo_qa).',
+                        textAlign: TextAlign.center,
+                      ),
+                      const SizedBox(height: 12),
+                      FilledButton(
+                        onPressed: widget.onReturnToStableHybrid,
+                        child: const Text('العودة للنسخة السابقة'),
+                      ),
+                    ],
+                  ),
+                ),
+              if (widget.showFallbackButton)
+                Positioned(
+                  left: 10,
+                  bottom: 72,
+                  child: Material(
+                    color: Colors.transparent,
+                    child: Tooltip(
+                      message: 'العودة الفورية للواجهة السابقة (0d734ca)',
+                      child: ActionChip(
+                        key: const Key('nasqo_fallback_previous_ui_btn'),
+                        avatar: const Icon(Icons.undo_rounded, size: 15),
+                        label: const Text(
+                          'العودة للسابقة',
+                          style: TextStyle(fontSize: 11),
+                        ),
+                        visualDensity: VisualDensity.compact,
+                        onPressed: widget.onReturnToStableHybrid,
+                      ),
+                    ),
+                  ),
+                ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}

